{
  "manifest_version": 3,
  "name": "GitPulse",
  "version": "2.0.0",
  "description": "Animate your live GitHub contribution graph — pick a form, theme, and text; it replaces the real streak grid on github.com.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "GitPulse",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content/graph.js"],
      "css": ["content/graph.css"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.vercel.app/*",
      "http://localhost:5173/*"
    ]
  }
}
