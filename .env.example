# ---- GitPulse dashboard (packages/site) ----
# Copy to .env and fill in. Server-side vars are used by the serverless
# functions in packages/site/api; VITE_* vars are inlined into the SPA build.

# GitHub OAuth App (https://github.com/settings/developers)
#   Authorization callback URL: https://<your-site>/api/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Upstash / Vercel KV REST for persisting per-user config.
# Without these the store falls back to an in-memory Map (ephemeral).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Exposed to the browser (safe to be public) ----
VITE_API_BASE=
VITE_GITHUB_CLIENT_ID=
# The unpacked/published extension id, so "Push to extension" works without a prompt.
VITE_EXTENSION_ID=
